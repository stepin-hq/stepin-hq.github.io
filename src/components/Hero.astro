---
import VideoModal from './VideoModal.astro';
import { useTranslations } from '../i18n';
const locale = Astro.currentLocale ?? 'en';
const t = useTranslations(locale);

const rawVideoUrl = t.hero.video_url ?? '';
const videoIdMatch = rawVideoUrl.match(/(?:v=|youtu\.be\/)([^&\n?#]+)/);
const videoId = videoIdMatch ? videoIdMatch[1] : rawVideoUrl;
const showVideo = t.hero.video_enabled && videoId;
---

<section class="relative overflow-hidden min-h-screen flex items-center">

  <!-- Animated perspective grid -->
  <div class="grid-host" aria-hidden="true">
    <div class="grid-stage">
      <div class="grid-plane"></div>
    </div>
    <div class="grid-fade"></div>
  </div>

  <!-- Content — hidden until grid animation completes -->
  <div class="site-container relative z-10 py-24 lg:py-32 xl:py-40 2xl:py-48 hero-content">
    <!-- Badge -->
    <div class="section-badge mb-6 mx-auto md:mx-0 w-fit">
      <span class="w-3 h-3 rounded-full bg-[#A2BCFF] shrink-0"></span>
      <span>{t.hero.badge}</span>
    </div>

    <!-- Heading -->
    <h1
      class="font-onest font-bold text-[#EDEDED] leading-[1.05] mb-6
        text-[44px] text-center tracking-[-0.56px]
        md:text-[48px] md:text-left md:tracking-normal
        lg:text-[64px]
        xl:text-[80px] xl:tracking-[-2px]
        2xl:text-[96px] 2xl:tracking-[-3px]
        max-w-[820px] xl:max-w-[1020px] 2xl:max-w-[1200px] mx-auto md:mx-0"
      style="text-shadow: 0px 1px 4px #2c4481;"
    >
      {t.hero.title_start} <span class="text-[#A2BCFF]">{t.hero.title_highlight}</span><br class="hidden md:block" /> {t.hero.title_end}
    </h1>

    <!-- Subtext -->
    <p class="font-onest font-normal text-[#CDD4E4] mb-10 max-w-[600px] xl:max-w-[720px]
      text-base text-center
      md:text-[18px] md:text-left
      xl:text-[20px] 2xl:text-[22px]
      mx-auto md:mx-0">
      {t.hero.subtitle}
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap gap-3 justify-center md:justify-start">
      <button data-open-modal="main-contact-modal" class="btn-primary flex-1 sm:flex-none text-center cursor-pointer border-0">{t.hero.cta_demo}</button>
      {showVideo && (
        <button data-open-video="hero-video-modal" class="btn-secondary flex-1 sm:flex-none text-center cursor-pointer border-0">{t.hero.cta_video}</button>
      )}
    </div>
  </div>
</section>

{showVideo && <VideoModal id="hero-video-modal" videoId={videoId} />}

<style>
  /* ── Grid host ──────────────────────────────────────────────────────────── */
  .grid-host {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
  }

  /* ── Grid stage — perspective container ─────────────────────────────────── */
  .grid-stage {
    position: absolute;
    inset: 0;
    perspective: 600px;
    perspective-origin: 50% 0%;
  }

  /* ── Grid plane ─────────────────────────────────────────────────────────── */
  .grid-plane {
    position: absolute;
    bottom: -10%;
    left: -60%;
    right: -60%;
    height: 130%;

    background-image:
      linear-gradient(rgba(162, 188, 255, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(162, 188, 255, 0.18) 1px, transparent 1px);
    background-size: 80px 80px;

    transform-origin: bottom center;
    will-change: transform, opacity;
    /* Default: resting perspective state — shown instantly on repeat loads */
    opacity: 1;
    transform: rotateX(76deg) scale(1);
  }

  /* When animating, the keyframe takes over from frame 0 */
  .grid-plane.is-animating {
    animation: gridReveal 5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  /*
    Start: nearly flat (rotateX 4°) + scaled up 4× — you're standing
           right on the grid, squares fill the entire view (zoomed in).
    Mid:   scale eases back as the tilt increases — pulling away.
    End:   rotateX 76°, scale 1 — the Figma perspective floor.
  */
  @keyframes gridReveal {
    0% {
      opacity: 0;
      transform: rotateX(4deg) scale(4);
    }
    8% {
      opacity: 1;
      transform: rotateX(6deg) scale(3.6);
    }
    100% {
      opacity: 1;
      transform: rotateX(76deg) scale(1);
    }
  }

  /* ── Gradient fade — dissolves grid at horizon and bottom edge ──────────── */
  .grid-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      #0a0a0a 0%,
      rgba(10, 10, 10, 0.6) 30%,
      transparent 62%,
      rgba(10, 10, 10, 0.15) 100%
    );
  }
</style>

<script>
  const GRID_DURATION_MS = 5000;

  // Guard against double-init: both DOMContentLoaded and astro:page-load fire
  // on the first page load, which would reset the animation and start two timers.
  let introStarted = false;

  function init() {
    const html    = document.documentElement;
    const plane   = document.querySelector<HTMLElement>('.grid-plane');
    const content = document.querySelector<HTMLElement>('.hero-content');

    if (!plane || !content) return;

    // Not a first load — nothing to do, content is already visible via CSS default
    if (!html.classList.contains('intro-playing')) {
      return;
    }

    if (introStarted) return;
    introStarted = true;

    // Mark as played so refreshes and navigation skip the intro
    sessionStorage.setItem('stepin-intro-played', '1');

    // Lock scroll for the duration
    document.documentElement.style.overflow = 'hidden';

    // Start grid animation from frame 0
    plane.classList.remove('is-animating');
    void plane.offsetWidth; // force reflow
    plane.classList.add('is-animating');

    setTimeout(() => {
      document.documentElement.style.overflow = '';
      html.classList.remove('intro-playing');

      // Use inline-style transitions instead of a CSS @keyframes animation.
      // CSS keyframe animations triggered by a class change in the same task as
      // removing the hiding rule are unreliable on iOS Safari (fill-mode bugs).
      content.style.opacity = '0';
      content.style.transform = 'translateY(12px)';

      // Force the browser to commit the starting state before the transition
      void content.offsetHeight;

      content.style.transition =
        'opacity 0.9s cubic-bezier(0.16,1,0.3,1), transform 0.9s cubic-bezier(0.16,1,0.3,1)';
      content.style.opacity = '1';
      content.style.transform = 'translateY(0)';

      // Clean up inline styles once the transition finishes
      const cleanup = () => {
        content.style.transition = '';
        content.style.opacity   = '';
        content.style.transform = '';
      };
      content.addEventListener('transitionend', cleanup, { once: true });
      // Safety fallback if transitionend never fires (e.g. display:none during anim)
      setTimeout(cleanup, 1100);
    }, GRID_DURATION_MS);
  }

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
</script>
